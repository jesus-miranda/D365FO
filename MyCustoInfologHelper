class MyCustoInfologHelper
{
    static boolean existMessage(str _message)
    {
        int infologLineNum = infologLine();
        int i;
        for (i = 1; i <= infologLineNum; i++)
        {
            str msg = infolog().text(i);
            if (strContains(msg,_message))
            {
                return true;
            }
        }
        return false;
    }

    static void removalByMessage(str _message)
    {
        InfologData _infologData = infolog().infologData();
        
        infolog().clear();

        SysInfologEnumerator sysInfologEnumerator = SysInfologEnumerator::newData(_infologData);
        while (sysInfologEnumerator.moveNext())
        {
            if (strContains(sysInfologEnumerator.currentMessage(), _message))
            {
                continue;
            }

            AxxInfologHelper::add(sysInfologEnumerator);
        }
    }

    static void removalAfterLineNum(int _logLineNumber)
    {
        InfologData _infologData = infolog().infologData();
        if (_logLineNumber == conLen(_infologData))
        {
            return;
        }

        infolog().clear();

        SysInfologEnumerator sysInfologEnumerator = SysInfologEnumerator::newData(_infologData);
        int infologDataIndex;
        while (sysInfologEnumerator.moveNext())
        {
            infologDataIndex++;
            if (infologDataIndex > _logLineNumber)
            {
                break;
            }

            AxxInfologHelper::add(sysInfologEnumerator);
        }
    }

    static void removalBeforeLineNum(int _logLineNumber)
    {
        InfologData _infologData = infolog().infologData();
        if (_logLineNumber == conLen(_infologData))
        {
            return;
        }

        infolog().clear();

        SysInfologEnumerator sysInfologEnumerator = SysInfologEnumerator::newData(_infologData);
        int infologDataIndex;
        while (sysInfologEnumerator.moveNext())
        {
            infologDataIndex++;
            if (infologDataIndex < _logLineNumber)
            {
                continue;
            }

            AxxInfologHelper::add(sysInfologEnumerator);
        }
    }

    static void removalLineNum(int _logLineNumber)
    {
        InfologData _infologData = infolog().infologData();
        if (_logLineNumber == conLen(_infologData))
        {
            return;
        }

        infolog().clear();

        SysInfologEnumerator sysInfologEnumerator = SysInfologEnumerator::newData(_infologData);
        int infologDataIndex;
        while (sysInfologEnumerator.moveNext())
        {
            infologDataIndex++;
            if (infologDataIndex == _logLineNumber)
            {
                continue;
            }

            AxxInfologHelper::add(sysInfologEnumerator);
        }
    }

